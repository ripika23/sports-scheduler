# Server Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=super_secret_sports_scheduler_key_2026_change_in_production

# PostgreSQL Database Configuration
# In production on Render, DATABASE_URL is automatically provided by Render Managed PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sports_scheduler

# Alternatively specify individual DB connection variables:
DB_NAME=sports_scheduler
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
