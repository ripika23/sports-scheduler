<%- include('../layouts/header') %>

<div class="form-page-container">
  <div class="form-card">
    <div class="form-header">
      <a href="/sessions/available" class="back-link">&larr; Back to Sessions</a>
      <h1 class="form-title">Schedule a Sports Session</h1>
      <p class="form-subtitle">Organize a match, assign starting rosters, and recruit players</p>
    </div>

    <form action="/sessions" method="POST" class="standard-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-row">
        <div class="form-group form-group-half">
          <label for="sportId" class="form-label">Sport Category <span class="required">*</span></label>
          <select id="sportId" name="sportId" class="form-select" required>
            <option value="" disabled selected>-- Select a Sport --</option>
            <% sports.forEach(function(sport) { %>
              <option value="<%= sport.id %>"><%= sport.sportName %></option>
            <% }); %>
          </select>
        </div>

        <div class="form-group form-group-half">
          <label for="sessionTitle" class="form-label">Session Title <span class="required">*</span></label>
          <input 
            type="text" 
            id="sessionTitle" 
            name="sessionTitle" 
            class="form-control" 
            placeholder="e.g. Saturday Morning 5v5 Friendly" 
            required
          >
        </div>
      </div>

      <div class="form-group">
        <label for="venue" class="form-label">Venue Location <span class="required">*</span></label>
        <input 
          type="text" 
          id="venue" 
          name="venue" 
          class="form-control" 
          placeholder="e.g. Riverside Sports Park, Pitch 3" 
          required
        >
      </div>

      <div class="form-row">
        <div class="form-group form-group-half">
          <label for="sessionDate" class="form-label">Match Date <span class="required">*</span></label>
          <input 
            type="date" 
            id="sessionDate" 
            name="sessionDate" 
            class="form-control" 
            min="<%= today %>" 
            required
          >
          <small class="form-text">Past dates are not permitted.</small>
        </div>

        <div class="form-group form-group-half">
          <label for="sessionTime" class="form-label">Start Time <span class="required">*</span></label>
          <input 
            type="time" 
            id="sessionTime" 
            name="sessionTime" 
            class="form-control" 
            required
          >
        </div>
      </div>

      <div class="roster-config-section">
        <h3>Starting Rosters & Teams</h3>
        <p class="text-sm text-muted">Enter the names of players already confirmed for each team (comma-separated).</p>

        <div class="form-row">
          <div class="form-group form-group-half">
            <label for="teamAPlayers" class="form-label">Team A Players</label>
            <textarea 
              id="teamAPlayers" 
              name="teamAPlayers" 
              class="form-control" 
              rows="3" 
              placeholder="e.g. <%= user.name %>, John, Michael"
            ></textarea>
            <small class="form-text">Comma-separated names of confirmed Team A players.</small>
          </div>

          <div class="form-group form-group-half">
            <label for="teamBPlayers" class="form-label">Team B Players</label>
            <textarea 
              id="teamBPlayers" 
              name="teamBPlayers" 
              class="form-control" 
              rows="3" 
              placeholder="e.g. David, Robert, Chris"
            ></textarea>
            <small class="form-text">Comma-separated names of confirmed Team B players.</small>
          </div>
        </div>
      </div>

      <div class="form-group">
        <label for="additionalPlayersNeeded" class="form-label">Additional Players Needed <span class="required">*</span></label>
        <input 
          type="number" 
          id="additionalPlayersNeeded" 
          name="additionalPlayersNeeded" 
          class="form-control" 
          min="0" 
          value="4" 
          required
        >
        <small class="form-text">Number of open player slots available for community members to join.</small>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-lg">Schedule Session</button>
        <a href="/sessions/available" class="btn btn-outline btn-lg">Cancel</a>
      </div>
    </form>
  </div>
</div>

<%- include('../layouts/footer') %>
