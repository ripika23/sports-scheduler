<%- include('../layouts/header') %>

<div class="form-page-container">
  <div class="form-card">
    <div class="form-header">
      <a href="/sports" class="back-link">&larr; Back to Sports Catalog</a>
      <h1 class="form-title">Add New Sport</h1>
      <p class="form-subtitle">Create a new sport category for players to organize matches in</p>
    </div>

    <form action="/sports" method="POST" class="standard-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label for="sportName" class="form-label">Sport Name <span class="required">*</span></label>
        <input 
          type="text" 
          id="sportName" 
          name="sportName" 
          class="form-control" 
          placeholder="e.g. Pickleball, Rugby, Swimming" 
          required 
          autofocus
        >
        <small class="form-text">Sport name must be unique.</small>
      </div>

      <div class="form-group">
        <label for="description" class="form-label">Sport Description</label>
        <textarea 
          id="description" 
          name="description" 
          class="form-control" 
          rows="4" 
          placeholder="Brief description of gameplay rules, equipment needed, or recommended team size..."
        ></textarea>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-lg">Create Sport</button>
        <a href="/sports" class="btn btn-outline btn-lg">Cancel</a>
      </div>
    </form>
  </div>
</div>

<%- include('../layouts/footer') %>
